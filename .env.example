# =====================================================================
#  Sougna - settings for Docker (the live server, or a test on your laptop)
# =====================================================================
# 1. Copy this file to a file named ".env" in the SAME folder (next to
#    docker-compose.yml):        cp .env.example .env
# 2. Replace every "change-me" value. Keep the single quotes.
# 3. NEVER put the .env file in Git (it is already ignored) and never send it
#    to anyone: it holds the keys to your database and your users' data.
#
# This is NOT backend/.env: that one is only for "python manage.py runserver"
# on your laptop while developing.
#
# Make strong random values with Python (run the command, copy the result):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# These only contain letters, digits, "-" and "_", so they are safe in this file.


# ---------------------------------------------------------------------
# Web address
# ---------------------------------------------------------------------

# The address of the site, WITHOUT https:// and WITHOUT www.
#   On the live server:  sougnadz.com
#   On your laptop:      localhost
# Caddy gets free HTTPS certificates for this address and for "www." + this
# address by itself, and sends www.sougnadz.com visitors to sougnadz.com.
# The domain's DNS "A records" (@ and www) must point to the server's IP address.
SITE_ADDRESS='sougnadz.com'

# The addresses Django answers to (several are separated by commas, no spaces).
#   On the live server:  sougnadz.com,www.sougnadz.com
#   On your laptop:      localhost
DJANGO_ALLOWED_HOSTS='sougnadz.com,www.sougnadz.com'


# ---------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------

# Django's secret key: signs login tokens and cookies. Long and random (see the
# Python command at the top). If it ever leaks, change it: everyone is logged out.
DJANGO_SECRET_KEY='change-me'

# ALWAYS False here. True shows error details (and secrets) to visitors.
DJANGO_DEBUG='False'

# HSTS: browsers remember to only ever use https for this site.
# 0 = off. Once https has worked for a few days on the real domain, set 3600
# (1 hour), then 31536000 (1 year). Leave 0 for localhost.
DJANGO_HSTS_SECONDS='0'


# ---------------------------------------------------------------------
# PostgreSQL database
# ---------------------------------------------------------------------
# The database is created with these values the FIRST time it starts.
# Changing them later does NOT change the existing database (see DEPLOY.md).

POSTGRES_DB='sougna'
POSTGRES_USER='sougna'
# Long and random (see the Python command at the top).
POSTGRES_PASSWORD='change-me'


# ---------------------------------------------------------------------
# SMS codes and moderation alerts
# ---------------------------------------------------------------------
# For now both are only PRINTED in the server logs (development mode):
#   docker compose logs -f backend
# Later (Phase 3): a real SMS provider and email alerts.

DJANGO_SMS_BACKEND='accounts.sms.ConsoleSMSBackend'
DJANGO_MODERATION_ALERT_BACKEND='moderation.alerts.ConsoleAlertBackend'
# Later, for email alerts:
# DJANGO_MODERATION_ALERT_BACKEND='moderation.alerts.EmailAlertBackend'
# DJANGO_MODERATION_ALERT_EMAILS='you@example.com'
