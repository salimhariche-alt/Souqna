# Copy this file to .env (in the same folder) and fill in real values.
# .env is ignored by git - never commit it.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Put it inside single quotes.
DJANGO_SECRET_KEY='replace-me'

# True on your own computer, False on a live server.
DJANGO_DEBUG=True

# Optional. Extra addresses the server answers to (comma-separated).
# localhost and 127.0.0.1 are always included; while DEBUG=True this laptop's
# current Wi-Fi address is added automatically.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.souqna.dz

# Optional. Extra web pages allowed to call the API from a browser (comma-separated).
# While DEBUG=True, localhost and local network addresses are already allowed.
# DJANGO_CORS_ALLOWED_ORIGINS=https://souqna.dz
