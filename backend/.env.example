# Copy this file to .env (in the same folder) and fill in real values.
# .env is ignored by git - never commit it.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Put it inside single quotes.
DJANGO_SECRET_KEY='replace-me'

# True on your own computer, False on a live server.
DJANGO_DEBUG=True

# Optional. The addresses the server answers to (comma-separated); replaces the default.
# Default with DEBUG=True: localhost, 127.0.0.1 and this laptop's current Wi-Fi address
# (added automatically). Default with DEBUG=False: sougnadz.com, www.sougnadz.com.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. How verification SMS are sent. Default: printed in the Django terminal.
# Later, point this at a real SMS provider class, e.g. accounts.sms_providers.MyProviderSMSBackend
# DJANGO_SMS_BACKEND=accounts.sms.ConsoleSMSBackend

# Optional. How URGENT moderation alerts (threats, terrorism) reach you.
# Default: printed in the Django terminal. Later, by email:
# DJANGO_MODERATION_ALERT_BACKEND=moderation.alerts.EmailAlertBackend
# DJANGO_MODERATION_ALERT_EMAILS=you@example.com

# Optional. Beta mode: invite codes to sign up, accounts verified by an admin instead
# of SMS codes, "Beta" label in the app. Default False. See the main .env.example.
# DJANGO_BETA_MODE=True

# Optional. Web pages allowed to call the API from a browser (comma-separated).
# While DEBUG=True, localhost and local network addresses are already allowed.
# With DEBUG=False the default is https://sougnadz.com and https://www.sougnadz.com.
# DJANGO_CORS_ALLOWED_ORIGINS=https://sougnadz.com,https://www.sougnadz.com

# Optional. Delivery between wilayas (see the main .env.example). Default: the FAKE company.
# DJANGO_DELIVERY_PROVIDER=delivery.providers.fake.FakeProvider
# DJANGO_DELIVERY_FAKE_STEP_MINUTES=2
# YALIDINE_API_ID=
# YALIDINE_API_TOKEN=
# ZR_EXPRESS_TOKEN=
# ZR_EXPRESS_KEY=
# MAYSTRO_API_KEY=
# SOUGNA_BUYER_FEE_PERCENT=5
# SOUGNA_BUYER_FEE_MIN_DZD=50
# SOUGNA_SAME_WILAYA_DROP_OFF=True
# SOUGNA_SAME_WILAYA_EXTRA_FEE_DZD=150
# SOUGNA_RELAY_HANDLING_DZD=150
